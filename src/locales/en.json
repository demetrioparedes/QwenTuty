  "steps": {
    "m1": {
      "step1": "Click the 'Install' button to download Antigravity.",
      "step2": "Click 'Open' to start your adventure."
    },
    "m2": {
      "step1": "Click 'New Workspace' to start.",
      "step2": "Type a project name (e.g. 'MarsBase') and click 'Create'."
    },
    "m3": {
      "step1": "Go to the 'Settings' tab.",
      "step2": "Select 'Assisted' mode and save changes."
    },
    "m4": {
      "step1": "Type 'visit google.com' in the terminal."
    },
    "m5": {
      "step1": "Click on the 'Artifacts' tab.",
      "step2": "Open the screenshot 'google_home.png'."
    },
    "m6": {
      "step1": "Go to Inbox and select another chat."
    },
    "m7": {
      "step1": "Request a 'Todo List' in the chat.",
      "step2": "Click on the plan and comment 'Change color'."
    },
    "m8": {
      "step1": "Activate 'Fast Mode'.",
      "step2": "Rename variable 'score' to 'puntos'."
    },
    "m9": {
      "step1": "Use Cmd+I (or Ctrl+I) in the editor.",
      "step2": "Ask to 'Create sum function'."
    },
    "m10": {
      "step1": "Open the file '.cursorrules'.",
      "step2": "Add rule: 'Always answer in Spanish'."
    },
    "m11": {
      "step1": "Start a task in Agent 1.",
      "step2": "Switch to Agent 2 and start another task."
    },
    "m12": {
      "step1": "Drag 'Test' block to workflow.",
      "step2": "Run the workflow."
    }
  },
